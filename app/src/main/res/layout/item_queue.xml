<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/queueRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingVertical="6dp"
    android:paddingStart="8dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/position"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="6dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_art"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Overdrive.Art" />

        <ImageView
            android:id="@+id/playingIndicator"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@string/now_playing"
            android:src="@drawable/ic_graphic_eq"
            android:visibility="gone"
            app:tint="@color/white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/queue_reorder_hint"
        android:padding="8dp"
        android:src="@drawable/ic_drag_handle"
        app:tint="@color/text_muted" />
</LinearLayout>
